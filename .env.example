# Diese Datei nach ".env" kopieren und bei Bedarf anpassen.
# Alle Werte sind optional – die App läuft auch ganz ohne .env.

# Port, auf dem der Server lauscht (Standard: 3000)
PORT=3000

# Geheimer Schlüssel für die Login-Tokens.
# Wenn leer, wird automatisch einer erzeugt und in der DB gespeichert.
# Für mehrere Server-Instanzen hier einen festen, langen Zufallswert setzen:
# APP_SECRET=bitte-hier-einen-langen-zufallsstring-einsetzen

# Pfad zur SQLite-Datenbankdatei (Standard: ./data/mcsammler.db)
# DB_PATH=./data/mcsammler.db
