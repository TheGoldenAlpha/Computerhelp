table(column=(type=decimal(0) updatewhereclause=yes name=fibubuchung_header_belegnummer dbname="fibubuchung_header.belegnummer" dbalias=".belegnummer" )
 column=(type=date updatewhereclause=yes name=fibubuchung_header_belegdatum dbname="fibubuchung_header.belegdatum" dbalias=".belegdatum" )
 column=(type=date updatewhereclause=yes name=fibubuchung_header_buchungsdatum dbname="fibubuchung_header.buchungsdatum" dbalias=".buchungsdatum" )
 column=(type=char(100) updatewhereclause=yes name=fibubuchung_body_text dbname="fibubuchung_body.text" dbalias=".text" )
 column=(type=char(10) updatewhereclause=yes name=fibubuchung_body_konto dbname="fibubuchung_body.konto" dbalias=".konto" )
 column=(type=char(1) updatewhereclause=yes name=fibubuchung_body_sollhaben dbname="fibubuchung_body.sollhaben" dbalias=".sollhaben" )
 column=(type=decimal(2) updatewhereclause=yes name=fibubuchung_body_betrag dbname="fibubuchung_body.betrag" dbalias=".betrag" )
 column=(type=char(10) updatewhereclause=yes name=fibubuchung_header_externe_belegnummer dbname="fibubuchung_header.externe_belegnummer" dbalias=".externe_belegnummer" )
 column=(type=char(50) updatewhereclause=yes name=fibubuchung_header_username dbname="fibubuchung_header.username" dbalias=".username" )
 column=(type=char(1) updatewhereclause=yes name=fibubuchung_body_visible dbname="fibubuchung_body.visible" dbalias=".visible" )
 column=(type=char(37) updatewhereclause=yes name=fibubuchung_body_bbid dbname="fibubuchung_body.bbid" dbalias=".bbid" )
 column=(type=char(37) updatewhereclause=yes name=fibubuchung_header_bid dbname="fibubuchung_header.bid" dbalias=".bid" )
 retrieve="  SELECT public.fibubuchung_header.belegnummer,   
         public.fibubuchung_header.belegdatum,   
         public.fibubuchung_header.buchungsdatum,   
         public.fibubuchung_body.text,   
         public.fibubuchung_body.konto,   
         public.fibubuchung_body.sollhaben,   
         public.fibubuchung_body.betrag,   
         public.fibubuchung_header.externe_belegnummer,   
         public.fibubuchung_header.username,   
         public.fibubuchung_body.visible,   
         public.fibubuchung_body.bbid,   
         public.fibubuchung_header.bid  
    FROM public.fibubuchung_body,   
         public.fibubuchung_header  
   WHERE ( public.fibubuchung_body.bidheader = public.fibubuchung_header.bid ) and  
         ( ( fibubuchung_header.buchungsjahr = :al_year ) AND  
         ( LOWER(CAST(public.fibubuchung_header.mid AS varchar)) = LOWER(:al_mid) ) ) AND  
         ( public.fibubuchung_body.visible = '1' OR public.fibubuchung_body.visible = '2' ) 
ORDER BY public.fibubuchung_header.belegnummer ASC, public.fibubuchung_body.sollhaben DESC, public.fibubuchung_body.visible ASC, public.fibubuchung_body.konto ASC   
" arguments=(("al_year", number),("al_mid", string)) )
