table(column=(type=char(200) updatewhereclause=yes name=kontenrahmen_vfibu_name dbname="kontenrahmen_vfibu.name" dbalias=".name" )
 column=(type=decimal(6) updatewhereclause=yes name=kontosaldo_live_vfibu_saldo dbname="kontosaldo_live_vfibu.saldo" dbalias=".saldo" )
 column=(type=long updatewhereclause=yes name=kontenrahmen_vfibu_year dbname="kontenrahmen_vfibu.year" dbalias=".year" )
 column=(type=char(200) updatewhereclause=yes name=mandanten_vfibu_company_name dbname="mandanten_vfibu.company_name" dbalias=".company_name" )
 column=(type=char(10) updatewhereclause=yes name=kontenrahmen_vfibu_kontonr dbname="kontenrahmen_vfibu.kontonr" dbalias=".kontonr" )
 column=(type=char(2) updatewhereclause=yes name=kontenrahmen_vfibu_kontotype dbname="kontenrahmen_vfibu.kontotype" dbalias=".kontotype" )
 column=(type=long updatewhereclause=yes name=kontenrahmen_vfibu_hierarchie dbname="kontenrahmen_vfibu.hierarchie" dbalias=".hierarchie" )
 column=(type=char(5) updatewhereclause=yes name=mandanten_vfibu_gj_start dbname="mandanten_vfibu.gj_start" dbalias=".gj_start" )
 retrieve="SELECT public.kontenrahmen_vfibu.name,   
       public.kontosaldo_live_vfibu.saldo,   
       public.kontenrahmen_vfibu.year,   
       public.mandanten_vfibu.company_name,   
       public.kontenrahmen_vfibu.kontonr,   
       public.kontenrahmen_vfibu.kontotype,   
       public.kontenrahmen_vfibu.hierarchie,   
       public.mandanten_vfibu.gj_start  
  FROM public.kontenrahmen_vfibu,   
       public.mandanten_vfibu,
       public.kontosaldo_live_vfibu  
 WHERE ( LOWER(CAST(public.kontenrahmen_vfibu.mandanten_id AS varchar)) = LOWER(CAST(public.mandanten_vfibu.id AS varchar)) ) AND  
       ( public.kontosaldo_live_vfibu.kontonr = public.kontenrahmen_vfibu.kontonr ) AND
       ( public.kontosaldo_live_vfibu.mandanten_id = public.kontenrahmen_vfibu.mandanten_id ) AND
       ( public.kontosaldo_live_vfibu.year = public.kontenrahmen_vfibu.year ) AND
       ( LOWER(CAST(public.kontenrahmen_vfibu.mandanten_id AS varchar)) = LOWER(:as_mid) ) AND  
       ( public.kontenrahmen_vfibu.year = :al_year ) AND  
       ( ( public.kontenrahmen_vfibu.kontotype = 'AK' ) OR  
       ( public.kontenrahmen_vfibu.kontotype = 'PA' ) ) AND  
       ( public.kontosaldo_live_vfibu.saldo <> 0 )
ORDER BY public.kontenrahmen_vfibu.kontotype ASC,   
         public.kontenrahmen_vfibu.sort_columns ASC" arguments=(("as_mid", string),("al_year", number)) )
